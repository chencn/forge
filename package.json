{
  "name": "forge",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "description": "Forge - Tauri desktop app",
  "scripts": {
    "tauri": "node --env-file-if-exists=.env ./node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "node --env-file-if-exists=.env ./node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "node --env-file-if-exists=.env ./node_modules/@tauri-apps/cli/tauri.js build",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:ts": "tsc --noEmit",
    "test:rs": "node scripts/run-rust.mjs test --lib",
    "check:rs": "node scripts/run-rust.mjs check",
    "browser:prepare": "node scripts/prepare-browser.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "browser:dev": "node scripts/prepare-browser.mjs --vite",
    "desktop:prepare": "node scripts/prepare-browser.mjs --release --frontend",
    "test:front": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tanstack/react-virtual": "^3.14.23",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "lucide-react": "^1.52.0",
    "marked": "^14.0.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "material-icon-theme": "^5.39.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
