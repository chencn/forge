{
  "name": "forge",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "description": "Forge - Tauri desktop app",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:ts": "tsc --noEmit",
    "test:rs": "node scripts/run-rust.mjs test --lib",
    "check:rs": "node scripts/run-rust.mjs check",
    "tauri": "node --env-file-if-exists=.env ./node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "node --env-file-if-exists=.env ./node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "node --env-file-if-exists=.env ./node_modules/@tauri-apps/cli/tauri.js build",
    "test:front": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.52.0",
    "marked": "^14.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "material-icon-theme": "^5.39.0",
    "typescript": "^5.9.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
